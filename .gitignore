# ---- build output ----
bin/
obj/
.publish-aot/
replica/.publish-aot/**
replica/tools/.mutation-backup/

# ---- large inputs and analysis databases: never tracked ----
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.pdb
*.dmp
target/*.exe
target/*.dll
target/db-backup-*/
target-alt/*.exe
target-*/*.exe

# ---- test run artefacts ----
TestResults/
*.trx
*.coverage
coverage*

# ---- oversized derived analysis output (recomputable from analysis/*.py) ----
analysis/pe_strings.txt
analysis/pe_strings_utf8.txt
analysis/replica_funcs.txt
analysis/replica_aot_funcs.txt
analysis/original_funcs.txt
analysis/strings_all.tsv
analysis/functions.tsv
analysis/_fp_*.tsv

# ---- temp ----
*.tmp
*.bak
*.orig
*~

# IDA leaves these beside an open database (R758)
target/*.$
target/*.id0
target/*.id1
target/*.id2
target/*.nam
target/*.til
replica/tools/.snapshots/

# R933: the previous artifact is kept on disk for comparison, not in the repository. Renaming .publish-aot to
# .publish-aot-prev moved it out from under the rule above and 110 MB of binaries went into a commit.
replica/.publish-aot-prev/
replica/.publish-aot-new/

# Antigravity workspace customizations: .agents/skills/* are COPIES of third-party skills
# (Seep-Reverse-Lab, cua-driver), regenerated by tools/sync-antigravity-skills.ps1.
# Measured in v44.9.1: the agent scanner skips NTFS junctions and ignores .agents/skills.json,
# so real copies are the only route that loads. They are derived, so they stay out of git;
# the plugin / rules / README under .agents/plugins are hand-written and ARE tracked.
.agents/skills/

# R1282: test/publish logs are scratch — write them to %TEMP% from now on, and never track them
.tmp-*.log
.tmp-*/
