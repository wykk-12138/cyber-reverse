<Project Sdk="Microsoft.NET.Sdk">
  <!-- WHY THIS EXISTS: the no-browser Kasada handshake, runnable on its own so the road can be checked
       against the live site without any of the replica's flow machinery. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KasadaHandshake</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\replica\src\Cybersole.Stores\Cybersole.Stores.csproj" />
  </ItemGroup>
</Project>
