<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cybersole.Core\Cybersole.Core.csproj" />
    <ProjectReference Include="..\..\src\Cybersole.Http\Cybersole.Http.csproj" />
    <ProjectReference Include="..\..\src\Cybersole.Services\Cybersole.Services.csproj" />
    <ProjectReference Include="..\..\src\Cybersole.Stores\Cybersole.Stores.csproj" />
    <ProjectReference Include="..\..\src\Cybersole.Ui\Cybersole.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!--
      R1167: the suite shares one on-disk settings file, because AppPaths.DataRoot is a static
      initialised once per process, while production code calls Config.Save() from 135 sites across the
      UI layer. Parallel collections therefore race a writer against a reader, which is the mechanism
      behind the GroupSummaryTests failures recorded in R806 and R1162. Serialising collections is the
      only single-point fix: enumerating the writers would mean most of the suite.
    -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
